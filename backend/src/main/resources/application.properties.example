# Application Name
spring.application.name=community-aggregator

# DataSource Configuration
# Use environment variables or replace with your actual values
spring.datasource.url=jdbc:mysql://[::1]:3306/community_aggregator?characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci
spring.datasource.username=your_username
spring.datasource.password=your_password
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

# JPA Configuration
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MariaDBDialect
spring.jpa.properties.hibernate.format_sql=true
spring.jpa.open-in-view=false

# SQL Script Initialization
spring.sql.init.mode=always
spring.jpa.defer-datasource-initialization=true
spring.sql.init.encoding=UTF-8

# Server Configuration
server.port=8080

# Logging Configuration
logging.level.com.community.aggregator=DEBUG
logging.level.org.hibernate.SQL=DEBUG
logging.level.org.hibernate.type.descriptor.sql.BasicBinder=TRACE

# ================================================
# SECURITY NOTE:
# ================================================
# 1. Copy this file to 'application.properties'
# 2. Replace 'your_username' and 'your_password' with actual values
# 3. NEVER commit application.properties to Git
#
# For production, use environment variables:
# spring.datasource.username=${DB_USERNAME}
# spring.datasource.password=${DB_PASSWORD}
